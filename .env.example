# Every setting is optional: the values below are the defaults.
# Copy this file to .env to change one. Docker Compose passes them all to the
# container, except the database path, the upload directory and the listen
# address, which the image sets to its data volume.

# Database and uploaded icons
DATABASE_URL=./statup.db
UPLOAD_DIR=data/uploads
DB_MAX_CONNECTIONS=10

# Server
HOST=0.0.0.0
PORT=3000

# Session lifetime in seconds (7 days)
SESSION_EXPIRY=604800

# Logging: trace, debug, info, warn, error
LOG_LEVEL=info
RUST_LOG=statup=info,tower_http=info

# Public mode: read-only pages accessible without signing in
PUBLIC_MODE=false

# Rate limiting keys requests on the client address. Behind a reverse proxy
# every visitor arrives with the proxy address, which turns the per client
# limit into a site wide one: set this to true so the real address is read
# from Forwarded / X-Forwarded-For. Leave it false when the app faces clients
# directly, otherwise anyone can forge those headers and skip the limit.
TRUST_PROXY_HEADERS=false

# Address visitors use to reach the instance, no trailing slash. Feed entries
# link back with it, and an https:// address marks the session cookie Secure.
# Defaults to the host of the incoming request.
# PUBLIC_URL=https://status.example.com

# Initial administrator, created on first run only. Leave these unset to
# create the first account from the sign-in page, which makes it the
# administrator. Never keep a password copied from an example.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
