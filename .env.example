# Every setting is optional: the values below are the defaults.
# Copy this file to .env to change one. Docker Compose passes them all to the
# container, except DATABASE_URL, UPLOAD_DIR, HOST and PORT, which belong to
# the image: the data stays in its volume, and the published port is set in
# docker-compose.yml.

# Time zone used until one is chosen. The first account's browser sets it,
# and Settings can change it; this only matters before that. Defaults to UTC.
# TZ=Europe/Paris

# Language for visitors whose browser asks for neither French nor English
DEFAULT_LOCALE=fr

# Database and uploaded icons
DATABASE_URL=./statup.db
UPLOAD_DIR=data/uploads
DB_MAX_CONNECTIONS=10

# Server, the listen address is an IP address
HOST=0.0.0.0
PORT=3000

# Seconds a sign-in form stays valid (7 days). Once signed in, a session
# lasts 30 days without a visit with "Stay signed in", 24 hours otherwise.
SESSION_EXPIRY=604800

# Logging: trace, debug, info, warn, error or off
LOG_LEVEL=info
# A finer filter per target. When set, it replaces LOG_LEVEL.
# RUST_LOG=statup=debug,tower_http=info

# Whether visitors read the page without an account, until an administrator
# chooses in Settings. That choice is then kept across restarts.
PUBLIC_MODE=false

# Rate limits key requests on the client address. Behind a reverse proxy
# every visitor arrives with the proxy address, which turns the per client
# limits into site wide ones: set this to true so the address is read from
# X-Real-IP, or the last entry of X-Forwarded-For or Forwarded. Leave it
# false when the app faces clients directly, otherwise anyone can forge those
# headers and walk around the limits.
TRUST_PROXY_HEADERS=false

# Address visitors use to reach the instance, no trailing slash. Feed entries
# link back with it, and an https:// address marks the session cookie Secure
# and sends HSTS. Defaults to the host of the incoming request.
# PUBLIC_URL=https://status.example.com

# Initial administrator, created at start when no account exists. Both are
# needed, and the password needs 12 characters or more. Leave them unset to
# create the first account from the browser. Remove them once the account
# exists, and never keep a password copied from an example.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
